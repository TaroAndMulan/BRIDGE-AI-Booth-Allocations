node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# The source workbook carries reviewer scores, institutions, and application IDs.
# On a public repo, committing it publishes them. The build only needs the
# derived src/generated/teams.json, which holds the six public columns.
data/*.xlsx

# Source PDFs. public/ holds what the site serves: manual.pdf is a 2.1MB
# re-encode of the 13MB master, team-list.pdf is copied verbatim.
data/*.pdf

# The 90 per-team certificates (~51MB of source, one PDF per booth) and the
# winners' award certificates, plus their served copies. The import scripts (part
# of the build) regenerate public/certificates/ and public/award-certificates/
# from the source; the committed manifests, src/generated/certificates.json and
# src/generated/award-certificates.json, are what dev reads.
data/certificate/
public/certificates/
public/award-certificates/
