# Data shown by the app.
#   excel (default) — the qualifying teams in src/generated/teams.json,
#                     produced from data/results.xlsx by `npm run import:excel`.
#   mock            — a small sample set in src/data.ts, for UI work.
VITE_DATA_SOURCE="excel"

# Awards tab — the live scoreboard's Apps Script Web App URL (…/exec). Leave blank
# to use the summit's built-in default. The backup tab reads results_2.xlsx instead
# (src/generated/awards.json via `npm run import:awards`) and needs no URL.
VITE_AWARDS_API_URL=""
